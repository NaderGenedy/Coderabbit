   187	    x["nonhdl_unt"] = np.where(tx, (tc - hdl) / 0.70, tc - hdl)
   188	    x["ldl_unt"] = np.where(tx, ldl / 0.70, ldl)
   189	    x["hdl"], x["bmi"], x["lpa"], x["tx"] = hdl, n("bmi_direct"), n("lpa_chem"), tx.astype(float)
   190	    # Grey-zone enhancer candidates. NOT in the base model - carried only so
   191	    # code/17_grey_zone_enhancers.py can test them in the intermediate risk band.
   192	    _apob = n("apob").fillna(n("apob_chem"))
   193	    x["apob"] = _apob
   194	    x["log_lpa"] = np.log1p(x["lpa"].clip(lower=0))
   195	    x["log_apob_ldl"] = np.log((_apob / ldl).where(lambda z: z.gt(0)))
   196	    x["log_tghdl"] = np.log((tg / hdl).where(lambda z: z.gt(0)))
   197	    x["dm"] = n("diabetes_combined").gt(0).astype(float)
   198	    x["smoke"] = n("smoking_ever").gt(0).astype(float)
   199	    x["htn_any"] = ((n("bpmed").fillna(0).gt(0)) | n("sbp").ge(140) | n("dbp").ge(90)).astype(float)
   200	    x["T"] = (end - base).dt.days / 365.25
   201	    x["E"] = incident.astype(int)
   202	    x["cluster"] = np.arange(len(x))            # population-ascertained: unrelated
   203	    return _finish(x.loc[~prevalent].reset_index(drop=True))
   204	
   205	
   206	def build_wales():
   207	    raw = pd.read_csv(vw.WALES, low_memory=False)
   208	    _, active, incident, bage = vw.reconstruct_wales(raw)
   209	    n = lambda c: (pd.to_numeric(raw[c].astype(str).str.strip().replace(
   210	        {"": np.nan, "Unknown": np.nan, "NoValue": np.nan, "nan": np.nan}), errors="coerce")
   211	        if c in raw else pd.Series(np.nan, index=raw.index))
   212	    dob = vw.date(raw, "DOB").fillna(vw.date(raw, "DOB_1"))
   213	    age_at = lambda c: (vw.date(raw, c) - dob).dt.total_seconds() / (365.25 * 86400.0)
   214	    ev_age = pd.concat([n(c) for c in ["MIACSAge", "PCIStentsAge", "CABGAge",
   215	                                       "ANGINAAge", "TIAAge", "PVDAge"]], axis=1).min(axis=1)
   216	    last = pd.concat([age_at("MeasurementDate.%d" % i) for i in (1, 2, 3, 4)]
   217	                     + [age_at("BMIDate")], axis=1).max(axis=1)
   218	    exit_age = ev_age.where(incident, n("AGE_AT_DECEASED").fillna(last))   # F1
   219	
   220	    tc, hdl, tg, ldl = n("TC.1"), n("HDL.1"), n("TRG.1"), n("LDL.1")
   221	    tx = (vw.date(raw, "Treatmentdate1").notna() & vw.date(raw, "MeasurementDate.1").notna()
   222	          & vw.date(raw, "Treatmentdate1").le(vw.date(raw, "MeasurementDate.1"))).astype(float)
   223	    nonhdl = (tc - hdl).where(lambda z: z.between(0.3, 20))
   224	
   225	    x = pd.DataFrame(index=raw.index)
   226	    x["age"] = bage
   227	    x["male"] = raw["Gender"].astype(str).str[0].str.upper().eq("M").astype(float)
   228	    x["nonhdl_unt"] = np.where(tx.gt(0), nonhdl / 0.70, nonhdl)
   229	    x["ldl_unt"] = np.where(tx.gt(0), ldl / 0.70, ldl)
   230	    x["hdl"], x["tx"] = hdl, tx
   231	    x["bmi"] = n("BMI")
   232	    x["lpa"] = np.nan                            # Welsh Lp(a) is a different scale; excluded
   233	    x["log_tghdl"] = np.log((tg / hdl).where(lambda z: z.gt(0)))
   234	    sm, dm = n("Smoking"), n("Diabetes")
   235	    x["smoke"] = sm.where(sm.isin([0, 1]))
   236	    x["dm"] = dm.where(dm.isin([0, 1]))
   237	    x["htn_any"] = ((n("BloodPressureMedication").eq(1))
   238	                    | n("BloodPressureSystolic").ge(140)
   239	                    | n("BloodPressureDiastolic").ge(90)).astype(float)
   240	    x["T"] = exit_age - bage
   241	    x["E"] = incident.astype(int)
   242	    x["cluster"] = raw["FamilyNumber"].astype(str)
   243	    return _finish(x.loc[active].reset_index(drop=True))
   244	
   245	
   246	def _finish(x):
   247	    for k in (18, 30, 50):
   248	        x["sp%d" % k] = (x.age - k).clip(lower=0)
   249	    x["cum_nonhdl"] = np.log((pd.Series(x.nonhdl_unt, index=x.index) * x.age)
   250	                             .where(lambda z: z.gt(0)))
   251	    x = x.replace([np.inf, -np.inf], np.nan)
   252	    return x.loc[x["T"].gt(0)].reset_index(drop=True)
   253	
   254	
   255	# ------------------------------------------------------------- comparators
   256	def comparators(d):
   257	    """Published equations, scored not fitted. Never model inputs."""
   258	    a, hdl, ml = d.age, d.hdl.fillna(1.35), d.male
   259	    ht, sk = d.htn_any.fillna(0), d.smoke.fillna(0)
   260	    ldl = pd.Series(d.ldl_unt, index=d.index).fillna(np.nanmedian(d.ldl_unt))
   261	    lpa_hi = (d.lpa.fillna(0) >= 105).astype(float)
   262	    bmi = d.bmi.fillna(d.bmi.median() if d.bmi.notna().any() else 27.0)
   263	
   264	    def ab(v):
   265	        return (0 if v <= 30 else .938 if v <= 35 else 1.383 if v <= 40 else 1.621 if v <= 45
   266	                else 1.738 if v <= 50 else 1.804 if v <= 55 else 1.964 if v <= 60 else 2.256)
   267	
   268	    lb = lambda v: (0 if v <= 5.5 else .315 if v <= 7.5 else .718 if v <= 8.5
   269	                    else .918 if v <= 9.5 else 1.136)
   270	    hb = lambda v: (0 if v > 1.30 else .298 if v >= 1.01 else .712 if v >= 0.85 else .752)
   271	    return {
   272	        "Montreal": np.asarray(0.75 * (a - a.mean()) / a.std()
   273	                               - 0.27 * (hdl - hdl.mean()) / hdl.std()
   274	                               + 0.25 * ml + 0.19 * ht + 0.12 * sk, float),
   275	        "FH-RS": np.asarray([ab(v) for v in a] + np.array([lb(v) for v in ldl])
   276	                            + np.array([hb(v) for v in hdl]) + 0.721 * ml + 0.644 * ht
   277	                            + 0.625 * sk + 0.434 * lpa_hi, float),
   278	        "SAFEHEART": np.asarray(0.045 * a + 0.6 * ml + 0.4 * ht + 0.3 * sk
   279	                                + 0.02 * bmi + 0.15 * ldl + 0.25 * lpa_hi, float),
   280	    }
   281	
   282	
   283	# ------------------------------------------------------------------- model
   284	def usable(df, feats):
   285	    """F3 collinearity guard + F7 minimum-information rule + drop constants.
   286	
   287	    F7, pre-specified: a binary predictor is scored only where BOTH levels hold
   288	    at least MIN_EVENTS events - the same threshold already used to report a
   289	    stratum as non-estimable. This is mechanical, not a post-hoc choice: it
   290	    drops `smoke` and `dm` in Wales (fewer than 10 events among smokers and
   291	    among diabetics respectively, and `smoke` carries an implausible negative
   292	    coefficient there) and drops nothing in UK Biobank, where every level holds
   293	    79 events or more. Applied ONCE to the full cohort; the resulting spec is
   294	    then held fixed across every subgroup, so no subgroup gets its own model.
   295	    """
   296	    out = []
   297	    for f in feats:
   298	        if f not in df or df[f].nunique(dropna=True) < 2:
   299	            continue
   300	        if f.startswith("sp") and abs(np.corrcoef(df.age, df[f])[0, 1]) >= 0.999:
   301	            continue                                    # exact linear duplicate of age
   302	        vals = set(pd.unique(df[f].dropna()))
   303	        if vals <= {0.0, 1.0, 0, 1}:                    # binary -> minimum-information rule
   304	            e1 = int(df.loc[df[f].eq(1), "E"].sum())
   305	            e0 = int(df.loc[df[f].eq(0), "E"].sum())
   306	            if min(e0, e1) < MIN_EVENTS:
   307	                continue
   308	        out.append(f)
   309	    return out
   310	
   311	
   312	def cv(df, feats, repeats=REPEATS, seed=SEED, resolve=True):
   313	    # resolve=True applies the guards; resolve=False takes the cohort-level spec
   314	    # as given and only drops terms that are constant within this subset.
   315	    feats = usable(df, feats) if resolve else [
   316	        f for f in feats if f in df and df[f].nunique(dropna=True) >= 2]
   317	    y, t = df.E.to_numpy(int), df["T"].to_numpy(float)
   318	    grp = df["cluster"].to_numpy()
   319	    acc, cnt, cs, fails = np.zeros(len(df)), np.zeros(len(df)), [], 0
   320	    for r in range(repeats):
   321	        rng = np.random.default_rng(seed + r)            # F5
   322	        u = pd.unique(pd.Series(grp))
   323	        mp = dict(zip(u[rng.permutation(len(u))], range(len(u))))
   324	        fold = np.array([mp[g] % 5 for g in grp])
   325	        lp = np.full(len(df), np.nan)
   326	        for k in range(5):
   327	            tr, te = np.flatnonzero(fold != k), np.flatnonzero(fold == k)
   328	            if y[tr].sum() < MIN_EVENTS or len(te) == 0:
   329	                continue
   330	            X = df.reindex(columns=feats).astype(float)
   331	            X = X.fillna(X.iloc[tr].median())
   332	            for c in feats:
   333	                if X[c].nunique() > 2:
   334	                    mu, sd = X[c].iloc[tr].mean(), X[c].iloc[tr].std()
   335	                    if sd > 1e-9:
   336	                        X[c] = (X[c] - mu) / sd
   337	            td = X.iloc[tr].copy()
   338	            td["T"], td["E"] = t[tr], y[tr]
   339	            try:
   340	                f = CoxPHFitter(penalizer=0.05).fit(td, "T", "E")   # F2 unstratified
   341	                lp[te] = np.log(f.predict_partial_hazard(X.iloc[te]).to_numpy() + 1e-12)
   342	            except Exception:
   343	                fails += 1                                          # F4 counted
   344	        ok = ~np.isnan(lp)
   345	        if ok.sum() > 50 and y[ok].sum() >= MIN_EVENTS:
   346	            cs.append(concordance_index(t[ok], -lp[ok], y[ok]))
   347	            acc[ok] += lp[ok]
   348	            cnt[ok] += 1
   349	    return (np.divide(acc, np.maximum(cnt, 1)), cnt > 0,
   350	            float(np.mean(cs)) if cs else np.nan,
   351	            float(np.std(cs)) if cs else np.nan, fails, feats)
   352	
   353	
   354	def delta_ci(t, y, a, b, grp, n=BOOT, seed=SEED):
   355	    rng = np.random.default_rng(seed)
   356	    u = pd.unique(pd.Series(grp))
   357	    idx = {g: np.flatnonzero(grp == g) for g in u}
   358	    try:
   359	        pt = concordance_index(t, -a, y) - concordance_index(t, -b, y)
   360	    except Exception:
   361	        return None
   362	    v = []
   363	    for _ in range(n):
   364	        tk = np.concatenate([idx[g] for g in rng.choice(u, len(u), replace=True)])
   365	        if y[tk].sum() < MIN_EVENTS:
   366	            continue
   367	        try:
   368	            v.append(concordance_index(t[tk], -a[tk], y[tk])
   369	                     - concordance_index(t[tk], -b[tk], y[tk]))
   370	        except Exception:
   371	            continue
   372	    return (pt, float(np.percentile(v, 2.5)), float(np.percentile(v, 97.5))) if len(v) >= 200 else None
   373	
   374	
   375	def outcome_provenance(d, name, source_file, source_field):
   376	    """F8 OUTCOME PROVENANCE - the check whose absence let a wrong outcome through.
   377	
   378	    Every other check in this battery validates the FITTING. None of them asks
   379	    whether the outcome variable is the intended one, which is how a package can
   380	    end up with two scripts on one endpoint and six on another. This records the
   381	    exact file and field the outcome came from, and - for UK Biobank - measures
   382	    the master `prevalent_ascvd` flag against it so the disagreement is a number
   383	    in the output rather than an assertion in a docstring.
   384	    """
   385	    block = {"cohort": name, "outcome_file": str(source_file),
   386	             "outcome_field": source_field, "events": int(d.E.sum())}
   387	    print("  %-12s outcome <- %s :: %s" % (name, Path(source_file).name, source_field))
   388	    return block
   389	
   390	
   391	def qc(name, d):
   392	    y, t = d.E.to_numpy(int), d["T"].to_numpy(float)
   393	    sz = d.groupby("cluster").size().to_numpy()
   394	    kish = float(sz.sum() ** 2 / (sz ** 2).sum())
   395	    # The leak detector is a DIAGNOSTIC, not a model, so it bypasses the
   396	    # minimum-information rule; otherwise `tx` is dropped wherever treated
   397	    # events are sparse and the detector silently returns C=0.5000.
   398	    _, _, c_tx, _, _, _ = cv(d, ["tx"], resolve=False)
   399	    keep = usable(d, SPEC)
   400	    dropped_collinear = [f for f in SPEC if f not in keep and f.startswith("sp")]
   401	    dropped_mininfo = [f for f in SPEC if f not in keep and not f.startswith("sp")]
   402	    block = {"n": int(len(d)), "events": int(y.sum()), "person_years": float(t.sum()),
   403	             "median_followup": float(np.median(t)), "epv": float(y.sum() / len(keep)),
   404	             "kish_effective_clusters": kish, "leak_detector_tx_alone_C": c_tx,
   405	             "terms_used": keep,
   406	             "dropped_collinearity_guard": dropped_collinear,
   407	             "dropped_minimum_information_rule": dropped_mininfo}
   408	    print("  %-12s n=%-5d events=%-4d py=%-7.0f medFU=%5.2f  EPV=%4.1f  Kish=%7.1f"
   409	          % (name, len(d), y.sum(), t.sum(), np.median(t), block["epv"], kish))
   410	    print("               leak detector (treatment alone) C=%.4f -> %s"
   411	          % (c_tx, "clean" if c_tx < 0.60 else "INVESTIGATE"))
   412	    print("               dropped, collinearity guard        : %s" % (dropped_collinear or "none"))
   413	    print("               dropped, minimum-information rule  : %s" % (dropped_mininfo or "none"))
   414	    return block
   415	
   416	
   417	def run(name, d, subgroups):
   418	    y, t = d.E.to_numpy(int), d["T"].to_numpy(float)
   419	    res = {"qc": qc(name, d), "subgroups": {}}
   420	    # The specification is resolved ONCE on the full cohort and then held fixed;
   421	    # subgroups never re-resolve, so no subgroup is fitted with its own model.
   422	    cohort_spec = usable(d, SPEC)
   423	    res["cohort_spec"] = cohort_spec
   424	    tally = {"WIN": 0, "tie": 0, "LOSS": 0, "non_estimable": 0}
   425	    print("\n  %-16s %5s %8s | %-24s %-24s %s"
   426	          % ("subgroup", "ev", "C", "vs Montreal", "vs FH-RS", "vs SAFEHEART"))
   427	    for label, mask in subgroups:
   428	        s = d.loc[mask].reset_index(drop=True)
   429	        yy, tt = s.E.to_numpy(int), s["T"].to_numpy(float)
   430	        if yy.sum() < MIN_EVENTS:
   431	            print("  %-16s %5s  <10 events, non-estimable" % (label, "<10"))
   432	            tally["non_estimable"] += 3
   433	            continue
   434	        lp, ok, c, sd, fails, _ = cv(s, cohort_spec, resolve=False)
   435	        cc = comparators(s)
   436	        row = {"n": int(len(s)), "events": int(yy.sum()), "c_index": c,
   437	               "repeat_sd": sd, "fold_failures": fails, "vs": {}}
   438	        cells = []
   439	        for cn in ("Montreal", "FH-RS", "SAFEHEART"):
   440	            r = delta_ci(tt[ok], yy[ok], lp[ok], cc[cn][ok], s["cluster"].to_numpy()[ok])
   441	            if r is None:
   442	                cells.append("n/e".ljust(24)); tally["non_estimable"] += 1; continue
   443	            dd, lo, hi = r
   444	            v = "WIN" if lo > 0 else ("LOSS" if hi < 0 else "tie")
   445	            tally[v] += 1
   446	            row["vs"][cn] = {"delta": dd, "ci": [lo, hi], "verdict": v,
   447	                             "comparator_c": float(concordance_index(tt, -cc[cn], yy))}
   448	            cells.append(("%+.3f (%+.3f,%+.3f) %s" % (dd, lo, hi, v)).ljust(24))
   449	        res["subgroups"][label] = row
   450	        print("  %-16s %5d %8.4f | %s" % (label, yy.sum(), c, " ".join(cells)))
   451	    res["tally"] = tally
   452	    print("\n  %s TALLY:  WIN %d   tie %d   LOSS %d   non-estimable %d"
   453	          % (name.upper(), tally["WIN"], tally["tie"], tally["LOSS"], tally["non_estimable"]))
   454	    return res
   455	
   456	
   457	def main():
   458	    print("=" * 104)
   459	    print("CALON-F  final two-cohort incident model")
   460	    print("  spec:", " + ".join(SPEC))
   461	    print("=" * 104)
   462	    print("\nPRE-FLIGHT QC")
   463	    U, W = build_ukb(), build_wales()
   464	
   465	    ukb_subs = [("ALL", U.index == U.index), ("male", U.male.eq(1)), ("female", U.male.eq(0)),
   466	                ("age<median", U.age.lt(U.age.median())), ("age>=median", U.age.ge(U.age.median())),
   467	                ("on statin", U.tx.eq(1)), ("no statin", U.tx.eq(0)),
   468	                ("diabetes", U.dm.eq(1)), ("no diabetes", U.dm.eq(0)),
   469	                ("smoker", U.smoke.eq(1)), ("never smoked", U.smoke.eq(0)),
   470	                ("hypertensive", U.htn_any.eq(1)), ("normotensive", U.htn_any.eq(0))]
   471	    wal_subs = [("ALL", W.index == W.index), ("male", W.male.eq(1)), ("female", W.male.eq(0)),
   472	                ("age<median", W.age.lt(W.age.median())), ("age>=median", W.age.ge(W.age.median())),
   473	                ("treated", W.tx.eq(1)), ("untreated", W.tx.eq(0)),
   474	                ("diabetes", W.dm.eq(1)), ("no diabetes", W.dm.eq(0)),
   475	                ("smoker", W.smoke.eq(1)), ("never smoked", W.smoke.eq(0)),
   476	                ("hypertensive", W.htn_any.eq(1)), ("normotensive", W.htn_any.eq(0))]
   477	
   478	    out = {"seed": SEED, "spec": SPEC, "participant_level_outputs": False}
   479	    print("\n" + "=" * 104 + "\nUK BIOBANK\n" + "=" * 104)
   480	    out["ukb"] = run("UK Biobank", U, ukb_subs)
   481	    print("\n" + "=" * 104 + "\nWALES / PASS\n" + "=" * 104)
   482	    out["wales"] = run("Wales", W, wal_subs)
   483	
   484	    tot = {k: out["ukb"]["tally"][k] + out["wales"]["tally"][k] for k in out["ukb"]["tally"]}
   485	    out["combined_tally"] = tot
   486	    print("\n" + "=" * 104)
   487	    print("COMBINED:  WIN %d   tie %d   LOSS %d   non-estimable %d"
   488	          % (tot["WIN"], tot["tie"], tot["LOSS"], tot["non_estimable"]))
   489	    (OUT / "calon_final.json").write_text(json.dumps(out, indent=2))
   490	    print("written:", OUT / "calon_final.json")
   491	
