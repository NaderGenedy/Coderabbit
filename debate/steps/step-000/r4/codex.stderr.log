    27	def report(name, d):
    28	    print("\n" + "=" * 92)
    29	    print(name)
    30	    print("=" * 92)
    31	    feats = cf.usable(d, cf.SPEC)
    32	
    33	    print("\nCOVARIATE COMPLETENESS (%% non-missing, n=%d)" % len(d))
    34	    for f in cf.SPEC:
    35	        if f in d:
    36	            pct = 100 * d[f].notna().mean()
    37	            flag = "  <-- SPARSE" if pct < 70 else ""
    38	            print("  %-12s %6.1f%%%s" % (f, pct, flag))
    39	
    40	    print("\nEVENTS BY STRATUM (governance: <10 suppressed)")
    41	    for f in ("dm", "smoke", "htn_any", "tx", "male"):
    42	        if f not in d:
    43	            continue
    44	        for v, lbl in ((1, "=1"), (0, "=0")):
    45	            e = int(d.loc[d[f].eq(v), "E"].sum())
    46	            print("  %-8s%-3s  n=%-5d events=%s"
    47	                  % (f, lbl, int(d[f].eq(v).sum()), e if e >= 10 else "<10"))
    48	
    49	    X = d.reindex(columns=feats).astype(float)
    50	    X = X.fillna(X.median())
    51	    sds = {c: (X[c].std() if X[c].nunique() > 2 else 1.0) for c in feats}
    52	    for c in feats:
    53	        if X[c].nunique() > 2:
    54	            X[c] = (X[c] - X[c].mean()) / (sds[c] if sds[c] > 1e-9 else 1.0)
    55	    X["T"], X["E"] = d["T"].to_numpy(float), d["E"].to_numpy(int)
    56	    f = CoxPHFitter(penalizer=0.05).fit(X, "T", "E")
    57	    s = f.summary
    58	
    59	    print("\nCOEFFICIENT SIGNS (full-cohort refit, penalised; per SD or per unit)")
    60	    print("  %-12s %8s %8s %-18s %s" % ("term", "coef", "HR", "95% CI", "sign vs expected"))
    61	    bad = []
    62	    for c in feats:
    63	        b, hr = s.loc[c, "coef"], s.loc[c, "exp(coef)"]
    64	        lo, hi = s.loc[c, "exp(coef) lower 95%"], s.loc[c, "exp(coef) upper 95%"]
    65	        got = "+" if b > 0 else "-"
    66	        exp = EXPECT.get(c, "?")
    67	        ok = "ok" if exp == "?" or got == exp else "UNEXPECTED (%s)" % exp
    68	        if ok != "ok":
    69	            bad.append(c)
    70	        print("  %-12s %8.4f %8.3f (%5.3f, %5.3f)  %s" % (c, b, hr, lo, hi, ok))
    71	
    72	    # calibration of the cross-validated linear predictor
    73	    lp, ok_m, cidx, sd, fails, _ = cf.cv(d, cf.SPEC)
    74	    cal = CoxPHFitter().fit(pd.DataFrame({"lp": lp[ok_m], "T": d["T"].to_numpy()[ok_m],
    75	                                          "E": d["E"].to_numpy()[ok_m]}), "T", "E")
    76	    slope = float(cal.summary.loc["lp", "coef"])
    77	    slo, shi = (float(cal.summary.loc["lp", "coef lower 95%"]),
    78	                float(cal.summary.loc["lp", "coef upper 95%"]))
    79	    print("\n  cross-validated C           %.4f  (repeat SD %.4f)" % (cidx, sd))
    80	    print("  Cox convergence failures    %d" % fails)
    81	    print("  calibration slope           %.3f (%.3f, %.3f)  [1.00 = no over/under-fit]"
    82	          % (slope, slo, shi))
    83	    print("  unexpected coefficient signs: %s" % (bad or "none"))
    84	    return {"features": feats, "c_index": cidx, "repeat_sd": sd, "fold_failures": fails,
    85	            "calibration_slope": [slope, slo, shi], "unexpected_signs": bad,
    86	            "completeness": {f: float(d[f].notna().mean()) for f in cf.SPEC if f in d}}
    87	
    88	
    89	def main():
    90	    out = {"ukb": report("UK BIOBANK", cf.build_ukb()),
    91	           "wales": report("WALES / PASS", cf.build_wales())}
    92	    (ROOT / "outputs" / "calon_final_qc.json").write_text(json.dumps(out, indent=2))
    93	    print("\nwritten:", ROOT / "outputs" / "calon_final_qc.json")
    94	
    95	
